  </cart-drawer><script>
  document.addEventListener('DOMContentLoaded', function () {
    const PINCODE_STORAGE_KEY = 'bluestar_checked_pincode';
    const DEFAULT_STOCK_THRESHOLD = 3;
    const ZERO_THRESHOLD_SKUS = new Set([
      'IA518TXFT','IA318VXFT','IF324DFT','IA512UXFT','IA512DXFT','IA518DXFT','IA312VXFT','IA322DXFT','IA312TXFT','IA318TXFT','IA312PXU','IA318PXU','IA512PXU','IA518PXU','IA309FTS','IC312HKFT','IC312TKFT','IC318TFT','IC318TKFT','IE318DKFT','IC318HKFT','IB312QXFT','IA316TXFT','IB318QXFT','IA322QXFT','IA312EXU','IA318EXU','IA322EXU','IA512EXU','IA518EXU'
    ]);

    function getEffectiveAvailableQty(response, sku) {
      const rawAvailableQty = Number(response && response.quantity);
      if (isNaN(rawAvailableQty)) return NaN;

      const responseThreshold = Number(response && response.threshold);
      const threshold = !isNaN(responseThreshold)
        ? responseThreshold
        : (ZERO_THRESHOLD_SKUS.has((sku || '').trim().toUpperCase()) ? 0 : DEFAULT_STOCK_THRESHOLD);

      return Math.max(rawAvailableQty - threshold, 0);
    }

    function getOrCreateDrawerPincodeWarning(wrapper) {
      const li = wrapper.closest('li.horizontal-product');
      if (!li) return null;

      let warning = li.querySelector(':scope > .pincode-availability-warning');

      if (!warning) {
        warning = document.createElement('div');
        warning.className = 'pincode-availability-warning text-xs text-red-600 mt-2';
        warning.style.display = 'none';

        // Insert as 2nd child of li
        if (li.children.length > 1) {
          li.insertBefore(warning, li.children[1]);
        } else {
          li.appendChild(warning);
        }
      }

      return warning;
    }

    function showDrawerPincodeWarning(wrapper, message) {
      const warning = getOrCreateDrawerPincodeWarning(wrapper);
      if (!warning) return;
      warning.textContent = message;
      warning.style.display = 'block';
    }

    function hideDrawerPincodeWarning(wrapper) {
      const warning = getOrCreateDrawerPincodeWarning(wrapper);
      if (!warning) return;
      warning.style.display = 'none';
    }

    function resolveDrawerPincode(wrapper) {
      const linePincode = (wrapper.dataset.pincode || '').trim();
      if (linePincode) return linePincode;
      return (window.localStorage && localStorage.getItem(PINCODE_STORAGE_KEY) || '').trim();
    }

    function checkDrawerPincodeAvailability(pincode, sku) {
      const encodedAuth = btoa('BLUESTAR:Blue*2024');
      return fetch('https://csca.bluestarindia.com/check-pincode', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Basic ' + encodedAuth
        },
        body: JSON.stringify({
          pincode: pincode,
          sku: sku
        })
      }).then(function (response) {
        if (!response.ok) throw new Error('Pincode API failed');
        return response.json();
      });
    }

    function setupDrawerPincodeGate() {
      document.querySelectorAll('#MiniCart cart-quantity, [id^="MiniCart-"] cart-quantity').forEach(function (wrapper) {
        const plusBtn = wrapper.querySelector('button[name="plus"]');
        const input = wrapper.querySelector('input.quantity__input');
        if (!plusBtn || !input || plusBtn.pincodeGateAttached) return;

        input.dataset.currentQty = String(parseInt(input.value, 10) || 0);

        plusBtn.addEventListener('click', function (event) {
          if (plusBtn.disabled) return;

          event.preventDefault();
          event.stopImmediatePropagation();
          hideDrawerPincodeWarning(wrapper);

          const sku = (wrapper.dataset.sku || '').trim();
          const pincode = resolveDrawerPincode(wrapper);
          if (!sku || !pincode) {
            showDrawerPincodeWarning(wrapper, 'Check pincode before increasing qty.');
            return;
          }

          const requestedQty = (parseInt(input.value, 10) || 0) + 1;
          checkDrawerPincodeAvailability(pincode, sku)
            .then(function (response) {
              const availableQty = getEffectiveAvailableQty(response, sku);
              if (!isNaN(availableQty) && availableQty >= requestedQty) {
                input.quantity = requestedQty;
                input.skipPincodeCheckOnce = true;
                input.dataset.currentQty = String(requestedQty);
                input.dispatchEvent(new Event('change', { bubbles: true }));
                return;
              }

              if (!isNaN(availableQty)) {
                showDrawerPincodeWarning(wrapper, 'Sorry - you have exceeded the stock available.');
              } else {
                showDrawerPincodeWarning(wrapper, 'Item unavailable for this pincode.');
              }
            })
            .catch(function () {
              showDrawerPincodeWarning(wrapper, 'Could not verify pincode. Try again.');
            });
        }, true);

        if (!input.pincodeGateAttached) {
          input.addEventListener('change', function (event) {
            if (input.skipPincodeCheckOnce) {
              input.skipPincodeCheckOnce = false;
              return;
            }

            const previousQty = parseInt(input.dataset.currentQty || input.defaultValue || '0', 10) || 0;
            const requestedQty = parseInt(input.value, 10);

            if (isNaN(requestedQty)) {
              event.preventDefault();
              event.stopImmediatePropagation();
              input.quantity = previousQty;
              return;
            }

            if (requestedQty <= previousQty) {
              hideDrawerPincodeWarning(wrapper);
              input.dataset.currentQty = String(requestedQty);
              return;
            }

            event.preventDefault();
            event.stopImmediatePropagation();

            const sku = (wrapper.dataset.sku || '').trim();
            const pincode = resolveDrawerPincode(wrapper);
            if (!sku || !pincode) {
              input.quantity = previousQty;
              showDrawerPincodeWarning(wrapper, 'Check pincode before increasing qty.');
              return;
            }

            checkDrawerPincodeAvailability(pincode, sku)
              .then(function (response) {
                const availableQty = getEffectiveAvailableQty(response, sku);
                if (!isNaN(availableQty) && availableQty >= requestedQty) {
                  hideDrawerPincodeWarning(wrapper);
                  input.skipPincodeCheckOnce = true;
                  input.dataset.currentQty = String(requestedQty);
                  input.dispatchEvent(new Event('change', { bubbles: true }));
                  return;
                }

                input.quantity = previousQty;
                if (!isNaN(availableQty)) {
                  showDrawerPincodeWarning(wrapper, 'Sorry - you have exceeded the stock available.');
                } else {
                  showDrawerPincodeWarning(wrapper, 'Item unavailable for this pincode.');
                }
              })
              .catch(function () {
                input.quantity = previousQty;
                showDrawerPincodeWarning(wrapper, 'Could not verify pincode. Try again.');
              });
          }, true);

          input.pincodeGateAttached = true;
        }

        plusBtn.pincodeGateAttached = true;
      });
    }

    setupDrawerPincodeGate();
    document.addEventListener('cart:updated', setupDrawerPincodeGate);
  });
</script>


