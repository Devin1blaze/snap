<div class="m_compare_products_floating_wrapper">
  <div class="m_compare_products_floating_button">
    <svg part="floating-button-icon" width="16" height="16" viewBox="0 0 20 20"><path d="M17 9a1 1 0 0 1-1-1c0-.551-.448-1-1-1H5.414l1.293 1.293a.999.999 0 1 1-1.414 1.414l-3-3a.999.999 0 0 1 0-1.414l3-3a.997.997 0 0 1 1.414 0 .999.999 0 0 1 0 1.414L5.414 5H15c1.654 0 3 1.346 3 3a1 1 0 0 1-1 1zM3 11a1 1 0 0 1 1 1c0 .551.448 1 1 1h9.586l-1.293-1.293a.999.999 0 1 1 1.414-1.414l3 3a.999.999 0 0 1 0 1.414l-3 3a.999.999 0 1 1-1.414-1.414L14.586 15H5c-1.654 0-3-1.346-3-3a1 1 0 0 1 1-1z" fill="currentColor"></path></svg>
    <p>Compare Products</p>
    <span class="compare_count_wrapper">(<span class="compare_count">0</span>)</span>
  </div>
</div>
<div class="m_compare_products_main">
  <div class="m_compare_products_overlay"></div>
  <div class="m_compare_products_popup">
    <div class="m_compare_products_popup_header">
      <p>Compare Products</p>
      <span class="m_compare_products_popup_close">&times;</span>
    </div>
    <div class="m_compare_products_popup_content_main">
      <div class="m_compare_products_popup_content"></div>
      <a href="/pages/compare-products" class="m_compare_product_btn">Compare</a>
    </div>
  </div>
</div>

<script>
  $(document).ready(function(){
    function updatePopupContent() {
      var compareArray = JSON.parse(localStorage.getItem('compareArray')) || [];
      var content = compareArray.map(function(product) { 
        return `
          <div class="compare-product" data-product-id="${product.id}" data-category="${product.type}">
            <button class="remove-product">&#10005;</button>
            <a href="${product.handle}" target="_blank">
              <img src="${product.image}" alt="${product.title}">
              <div class="compare_prodTitle">${product.title}</div>
              <div class="compare_prodPrice">${product.price}</div>
            </a>
          </div>
        `;
      }).join('');
      
      $('.m_compare_products_popup_content').html(content);

      if($('.m_compare_products_popup_content .compare-product').length > 1) {
        $('.m_compare_product_btn').removeClass('disabledButton');
      } else {
        $('.m_compare_product_btn').addClass('disabledButton');
      }

      setTimeout(function(){
        $('input.addToCompare').each(function() {
          var productType = $(this).attr('data-product-type');
          var productId = $(this).attr('data-product-id');
          // console.log(checkboxProduct);
          var existingProductType = compareArray.length > 0 ? compareArray[0].type : null;
          
          if (existingProductType && productType !== existingProductType) {
            $(this).prop('disabled', true);
            $(this).closest('label').addClass('disabledCompare');
          } else {
            if (compareArray.some(p => p.id === productId)) {
              $(this).prop('checked', true);
              $(this).closest('label').addClass('activeCheckbox');
            } else {
              $(this).prop('checked', false);
              $(this).closest('label').removeClass('activeCheckbox');
            }
        
            if (compareArray.length >= 3 && !compareArray.some(p => p.id === productId)) {
              $(this).prop('disabled', true);
              $(this).closest('label').addClass('disabledCompare');
            } else {
              $(this).prop('disabled', false);
              $(this).closest('label').removeClass('disabledCompare');
            }
          }
        });
      }, 200);

      if(window.location.href.indexOf('/compare-products') > 0) {
        $('.m_compare_products_floating_wrapper').hide();
      } else {
        if (compareArray.length === 0) {
          $('.m_compare_products_floating_wrapper').hide();
        } else {
          $('.m_compare_products_floating_wrapper').show();
        }
      }
    
      var count = compareArray.length;
      $('.compare_count').text(count);
      $('.compare_count_wrapper').toggleClass('hasCount', count > 0);
    }
    
    updatePopupContent();
    
    var compareArray = JSON.parse(localStorage.getItem('compareArray')) || [];
    var count = compareArray.length;
    
    $('.compare_count').text(count);
    $('.compare_count_wrapper').toggleClass('hasCount', count > 0);
    
    $('body').on('change', '.addToCompare', function() {
      console.log('changed');
      var productJson = $(this).attr('data-product-json');
      var product = JSON.parse(productJson);
      var productId = product.id;
    
      if (this.checked) {
        if (compareArray.length < 3 && !compareArray.some(p => p.id === productId)) {
          compareArray.push(product);
          count++;
          $(this).closest('label').addClass('activeCheckbox');
        } else {
          $(this).prop('checked', false);
          $(this).closest('label').removeClass('activeCheckbox');
          alert("You can only compare up to 3 products.");
        }
      } else {
        compareArray = compareArray.filter(p => p.id !== productId);
        count--;
      }
    
      localStorage.setItem('compareArray', JSON.stringify(compareArray));
      updatePopupContent(); 
    });
    
    $(document).on('click', '.remove-product', function() {
      var productId = $(this).closest('.compare-product').data('product-id');
      // console.log('Product ID to remove:', productId); 
    
      compareArray = JSON.parse(localStorage.getItem('compareArray')) || [];
      compareArray = compareArray.filter(p => String(p.id) !== String(productId));
      localStorage.setItem('compareArray', JSON.stringify(compareArray));
      count--;
    
      updatePopupContent(); 
      if(count == 0) {
        closePopup();
      }
    });

  
    $('.m_compare_products_floating_button').click(function(){
      $('.m_compare_products_main').css('display', 'block');
      setTimeout(function(){
        $('.m_compare_products_main').addClass('show').css('visibility', 'visible');
      }, 10);
    });
  
    $('.m_compare_products_popup_close, .m_compare_products_overlay').click(function() {
      closePopup();
    });
  
    // $(document).on('click', function(event) {
    //   if (!$(event.target).closest('.m_compare_products_popup, .m_compare_products_floating_button').length) {
    //     closePopup();
    //   }
    // });
  
    function closePopup() {
      $('.m_compare_products_main').removeClass('show');
      setTimeout(function() {
        $('.m_compare_products_main').css('visibility', 'hidden').css('display', 'none');
      }, 300);
    }
  });

</script>

</div>
  
  <script>
    document.addEventListener("DOMContentLoaded", function() {
    var lazyVideos = [].slice.call(document.querySelectorAll("video.m_pvf_lazy"));
  
    if ("IntersectionObserver" in window) {
      var lazyVideoObserver = new IntersectionObserver(function(entries, observer) {
        entries.forEach(function(video) {
          if (video.isIntersecting) {
            for (var source in video.target.children) {
              var videoSource = video.target.children[source];
              if (typeof videoSource.tagName === "string" && videoSource.tagName === "SOURCE") {
                videoSource.src = videoSource.dataset.src;
              }
            }
  
            video.target.load();
            video.target.classList.remove("m_pvf_lazy");
            lazyVideoObserver.unobserve(video.target);
          }
        });
      });
  
      lazyVideos.forEach(function(lazyVideo) {
        lazyVideoObserver.observe(lazyVideo);
      });
    }
  });
  </script>



