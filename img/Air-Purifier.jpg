<script>
  $(document).ready(function () {
    $('body').on('click', '.m-condition-close-popup', function () {
      $('.m-agree-condition-popup').hide();
      $('.m-is-btn-disabled-checkout').prop('disabled', true);
    });

    $('body').on('click', '.m-agree-condition-popup', function () {
      $('.m-agree-condition-popup').hide();
      $('.m-is-btn-disabled-checkout').prop('disabled', true);
    });

    $('body').on('click', '.m-agree-condition-popup-container', function (event) {
      event.stopPropagation();
    });  

    $('body').on('change', '#myCheckbox', function (event) {
      event.preventDefault(); 
      $(this).prop('checked', false);
      $('.m-agree-condition-popup').toggle();
    });

    $('body').on('click', '.m-popup-agree-button', function (event) {
      event.preventDefault();
      $('#myCheckbox').prop('checked', true);
      $('.m-is-btn-disabled-checkout').prop('disabled', false);
      $('.m-agree-condition-popup').hide();
    });

    setTimeout(function () {
      if ($('#myCheckbox').is(':checked')) {
        $('.m-is-btn-disabled-checkout').prop('disabled', false);
      }
    }, 100);
  });
</script>
                   

