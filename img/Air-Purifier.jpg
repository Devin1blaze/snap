  <div id="shopify-section-m-compare-product" class="shopify-section"><style>
  .emptyMetafields, .disabledButton {
    pointer-events: none;
    cursor: none;
    opacity: 0.5;
  }
  .m_compare_products_floating_wrapper {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translate(-50%);
    z-index: 9;
    display: none;
  }
  .m_compare_products_floating_button {
    display: flex;
    align-items: center;
    column-gap: 5px;
    padding: 10px 15px;
    border-radius: 6px 6px 0 0;
    background: #005aaa;
    color: white;
    cursor: pointer;
    width: max-content;
  }
  .m_compare_products_main {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    visibility: hidden;
    background: rgba(0, 0, 0, 0.575);
  }
  .m_compare_products_overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  .m_compare_products_main.show .m_compare_products_overlay {
    opacity: 1;
  }
  .m_compare_products_popup {
    position: absolute;
    left: 50%;
    bottom: -100%;
    transform: translate(-50%, 0);
    width: 80%;
    max-width: 700px;
    background: white;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
    transition: bottom 0.3s ease-in-out;
  }
  .m_compare_products_main.show .m_compare_products_popup {
    bottom: 0;
  }
  .m_compare_products_popup_header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background: #005aaa;
    color: white;
    position: sticky;
    top: 0;
  }
  .m_compare_products_popup_close {
    cursor: pointer;
    font-size: 24px;
  }
  .m_compare_products_popup_content {
    padding: 20px;
    display: flex;
    justify-content: center;
    gap: 15px;
  }
  label.m_addtocompare_label {
    padding: 15px 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    column-gap: 10px;
    cursor: pointer;
  }
  .card:not(.m_card_home) label.m_addtocompare_label {
    width: fit-content;
    margin: 0 auto;
    min-width: 40%;
    background: #d8e8f7ad;
    border-radius: 6px;
  }
  .compare_count_wrapper {
    display: none;
  }
  .compare_count_wrapper.hasCount {
    display: block;
  }
  .compare-product {
    max-width: 200px;
    border: 1px solid;
    padding: 10px;
    position: relative;
  }
  .compare-product img {
    background: #fafafa;
    border: 1px solid #d0d0d0;
    height: 180px;
    width: 180px;
    object-fit: contain;
  }
  .m_compare_product_btn {
    display: block;
    border: 2px solid var(--color-button-gradient);
    background: var(--color-button-gradient);
    color: #fff;
    padding: 10px;
    width: max-content;
    text-align: center;
    border-radius: 5px;
    cursor: pointer;
    margin: 0 auto 30px;
  }
  .remove-product {
    content: '×';
    position: absolute;
    right: -10px;
    top: -10px;
    padding: 5px 5px 6px;
    border-radius: 50%;
    background: black;
    color: white;
    width: 25px;
    height: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: normal;
    cursor: pointer;
  }
  .compare_prodTitle {
    margin: 10px 0;
  }
  .compare-product img, .compare-product {
    border-radius: 4px;
  }
  @media (max-width: 600px) {
    .m_compare_products_popup {
      width: 98%;
    }
    .m_compare_product_btn {
      margin: 0 auto 10px;
    }
    .m_compare_products_popup_content {
      padding: 20px 10px;
      gap: 5px;
    }
    .compare_prodTitle {
      margin: 5px 0;
      font-size: 13px;
    }
    .compare_prodPrice {
      font-size: 13px;
    }
    .remove-product {
      right: -5px;
      top: -5px;
      padding: 4px 4px 5px;
      font-size: 12px;
      width: 20px;
      height: 20px;
    }
  }
</style>

