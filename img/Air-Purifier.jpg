        countrySearchPlaceholder: active_locale.otp_sub_title ?? simplyOtp.otp_widgets.otp_sub_title ?? "Search...",
        emptySearchMessage: active_locale.otp_sub_title ?? simplyOtp.otp_widgets.otp_sub_title ?? "No results found..!",
        otpConsentElement: `
